<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.shape.SVGPath?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="nl.sortsmart.javafx.controller.StationsdisplayController"
      spacing="0" styleClass="display-wrapper" VBox.vgrow="ALWAYS">

    <!-- Inklapbare simulatiebalk voor hardware-testing -->
    <TitledPane fx:id="simTitledPane" text="⚙ Simulatiebediening (Micro:bit / Hardware-emulator)"
                expanded="false" styleClass="sim-titled-pane">
        <HBox spacing="14" alignment="CENTER_LEFT" styleClass="sim-pane-content">
            <Label text="Station:" styleClass="sim-label"/>
            <ComboBox fx:id="simStationCombo" prefWidth="180" styleClass="sim-combo"/>
            <Region HBox.hgrow="ALWAYS"/>
            <HBox fx:id="simKnoppenBox" spacing="8" alignment="CENTER_RIGHT"/>
        </HBox>
    </TitledPane>

    <!-- Stationsdisplay (Namaak Mockups 1 t/m 6) -->
    <VBox fx:id="displayRoot" spacing="30" styleClass="display-root-normal" VBox.vgrow="ALWAYS">
        <padding>
            <Insets top="36" right="48" bottom="36" left="48"/>
        </padding>

        <!-- Bovenbalk: Merknaam links, statuspill rechts -->
        <HBox fx:id="headerBar" alignment="CENTER_LEFT">
            <Label text="SortSmart" styleClass="display-brand"/>
            <Region HBox.hgrow="ALWAYS"/>
            <HBox fx:id="statusPill" alignment="CENTER" spacing="8" styleClass="display-status-pill">
                <Circle fx:id="statusDot" radius="5"/>
                <Label fx:id="statusLabel" text="Klaar" styleClass="display-status-text"/>
            </HBox>
        </HBox>

        <Region VBox.vgrow="ALWAYS"/>

        <!-- Centraal deel: Cirkel links, tekst in het midden, camera rechts -->
        <HBox alignment="CENTER_LEFT" spacing="32">
            <!-- Grote ronde cirkel met icoon -->
            <StackPane fx:id="circleContainer" minWidth="170" minHeight="170" maxWidth="170" maxHeight="170"
                       styleClass="display-circle">
                <SVGPath fx:id="circleIcon"/>
            </StackPane>

            <!-- Tekstkolom & Handmatige knoppen -->
            <VBox fx:id="textContainer" spacing="10" alignment="CENTER_LEFT" HBox.hgrow="ALWAYS">
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <Label fx:id="tagLabel" text="HERKEND" visible="false" managed="false" styleClass="display-tag"/>
                    <Label fx:id="lblHerkentijd" text="" visible="false" managed="false" styleClass="display-latency"/>
                </HBox>
                <Label fx:id="headingLabel" text="Gooi je afval in de bak" styleClass="display-heading" wrapText="true"/>
                <Label fx:id="descriptionLabel"
                       text="Eén item tegelijk. SortSmart sorteert het daarna zelf in de juiste bak."
                       styleClass="display-description" wrapText="true"/>
                <ProgressBar fx:id="scanProgressBar" prefWidth="380" prefHeight="10"
                             visible="false" managed="false" styleClass="display-scan-bar"/>

                <!-- Bedieningsknoppen voor herkenning -->
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <padding><Insets top="6"/></padding>
                    <Button fx:id="btnNuScannen" text="⚡ Nu scannen" onAction="#nuScannen" styleClass="btn-primary"/>
                    <Button fx:id="btnFotoKiezen" text="📁 Foto kiezen" onAction="#fotoKiezen" styleClass="btn-secondary"/>
                    <Button fx:id="btnAnnuleren" text="✖ Annuleren" onAction="#annuleerScan" visible="false" managed="false" styleClass="btn-secondary"/>
                </HBox>
            </VBox>

            <!-- Live Camera Preview (uitsluitend in geheugen) -->
            <VBox spacing="6" alignment="CENTER_RIGHT">
                <StackPane fx:id="cameraContainer" minWidth="240" minHeight="160" maxWidth="240" maxHeight="160"
                           styleClass="camera-preview-container">
                    <ImageView fx:id="cameraPreviewView" fitWidth="236" fitHeight="156" preserveRatio="true"/>
                    <VBox fx:id="cameraFallbackBox" alignment="CENTER" spacing="8" visible="false" styleClass="camera-fallback-box">
                        <Label text="📷 Geen camerabeeld" styleClass="camera-fallback-title"/>
                        <Button text="Foto kiezen..." onAction="#fotoKiezen" styleClass="btn-secondary-sm"/>
                    </VBox>
                </StackPane>
                <Label fx:id="cameraStatusLabel" text="Camera: Verbinding zoeken..." styleClass="camera-status-text"/>
            </VBox>
        </HBox>

        <Region VBox.vgrow="ALWAYS"/>

        <!-- Ondervakken (Mockups 1, 2, 3, 5, 6) -->
        <HBox fx:id="fractieVakkenContainer" spacing="16" alignment="CENTER">
            <!-- Dynamisch opgebouwd vanuit afvalfractie tabel -->
        </HBox>

        <!-- Geluktbalk onderaan (Mockup 4: Gelukt!) -->
        <HBox fx:id="geluktBalkContainer" alignment="CENTER_LEFT" spacing="16"
              visible="false" managed="false" styleClass="display-gelukt-balk">
            <padding>
                <Insets top="18" right="24" bottom="18" left="24"/>
            </padding>
            <Label fx:id="geluktBalkTitel" text="Nog iets weg te gooien?" styleClass="display-gelukt-balk-title"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="geluktBalkSub" text="Leg het volgende item in het bakje" styleClass="display-gelukt-balk-sub"/>
        </HBox>

    </VBox>

</VBox>
