<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="nl.sortsmart.javafx.controller.DashboardController"
      spacing="12" styleClass="screen-container">

    <!-- Koptekst -->
    <HBox alignment="CENTER_LEFT" spacing="12" styleClass="screen-header">
        <Label text="Dashboard" styleClass="screen-title"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="⟳ Vernieuwen" onAction="#vernieuwen" styleClass="btn-secondary"/>
    </HBox>

    <!-- Scrollbaar station-overzicht -->
    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" styleClass="dashboard-scroll">
        <VBox fx:id="stationsContainer" spacing="16" styleClass="stations-container"/>
    </ScrollPane>

</VBox>
