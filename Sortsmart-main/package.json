{
  "name": "sorte",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/web",
    "apps/server"
  ],
  "scripts": {
    "dev": "npm run dev -w @sorte/web",
    "build": "npm run build -w @sorte/web",
    "start": "npm run start -w @sorte/server",
    "typecheck": "tsc -p packages/core && tsc -p packages/ui && tsc -p apps/server && tsc -p apps/web",
    "test": "vitest run"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
